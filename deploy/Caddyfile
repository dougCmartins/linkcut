# DOMAIN comes from .env.production. Caddy gets and renews the https certificate (Let's Encrypt) by itself.
{$DOMAIN} {
	encode zstd gzip

	# Access log required by the Marco Civil da Internet (art. 15): IP, date/time, method, path and status, kept
	# 6 months, in the caddy_data volume. Headers (tokens, cookies, user agent) are left out (LGPD: minimum data).
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 500
			roll_keep_for 4320h
		}
		format filter {
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}

	# The API and the uploaded images (same address as the SPA: no CORS).
	@api path /api/* /storage/* /up
	handle @api {
		reverse_proxy app:8080
	}

	# Link previews: WhatsApp, Facebook, X... read the HTML and do not run JavaScript, so a barbershop's page
	# (/rafael, /rafael/portfolio and their /agendar links) goes to the API, which answers with its name, bio and
	# photo (Open Graph). iMessage and Instagram send facebookexternalhit.
	# People always get the SPA below.
	@previewBots {
		header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|meta-externalagent|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview|redditbot|applebot|googlebot|google-inspectiontool|bingbot|embedly|iframely|vkshare|mastodon|snapchat|viber|line-poker|kakaotalk)
		path_regexp page ^/([a-z0-9]+(?:-[a-z0-9]+)*)(/portfolio)?(/agendar)?/?$
		not path /painel* /conta* /entrar* /cadastrar* /privacidade* /termos*
	}
	handle @previewBots {
		rewrite * /api/og/{re.page.1}{re.page.2}{re.page.3}
		reverse_proxy app:8080
	}

	# The SPA: real files when they exist, otherwise index.html (Vue Router handles /rafael, /painel...).
	handle {
		root * /srv
		@hashed path /assets/* /fonts/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Only our own code runs; the API, the ZIP code lookup (ViaCEP) and Sentry are the only connections.
		# Inline styles stay allowed (Vue sets theme colours on elements); scripts never inline.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://viacep.com.br https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
