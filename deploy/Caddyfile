# DOMAIN comes from .env.production. Caddy gets and renews the https certificate (Let's Encrypt) by itself.
{$DOMAIN} {
	encode zstd gzip

	# The API and the uploaded images (same address as the SPA: no CORS).
	@api path /api/* /storage/* /up
	handle @api {
		reverse_proxy app:8080
	}

	# Link previews: WhatsApp, Facebook, X... read the HTML and do not run JavaScript, so a barbershop's page
	# (/rafael, /rafael/portfolio) goes to the API, which answers with its name, bio and photo (Open Graph).
	# People always get the SPA below.
	@previewBots {
		header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest)
		path_regexp page ^/([a-z0-9]+(?:-[a-z0-9]+)*)(/portfolio)?/?$
		not path /painel* /conta* /entrar* /cadastrar* /privacidade*
	}
	handle @previewBots {
		rewrite * /api/og/{re.page.1}{re.page.2}
		reverse_proxy app:8080
	}

	# The SPA: real files when they exist, otherwise index.html (Vue Router handles /rafael, /painel...).
	handle {
		root * /srv
		@hashed path /assets/* /fonts/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
