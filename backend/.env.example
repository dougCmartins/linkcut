APP_NAME=linkcut
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8087

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# json = one JSON object per line on stderr (Docker/production). Use "single" for a plain file.
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker. From the host machine use DB_HOST=127.0.0.1 and DB_PORT=3309.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=linkcut
DB_USERNAME=linkcut
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in Docker: see the e-mails (2FA codes) at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@linkcut.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# SPA origins allowed by CORS (comma separated)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# 2FA by SMS. "log" writes to storage/logs/sms.log (local only; refused in production).
SMS_DRIVER=log

# Sentry (empty DSN = off). Tags tenant_id/user_id/request_id are added per request.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=false

# Laravel Pulse at /pulse. Open in local; elsewhere HTTP Basic Auth.
# PULSE_PASSWORD_HASH: php artisan tinker --execute="echo bcrypt('your-password');"
PULSE_ENABLED=true
PULSE_USER=
PULSE_PASSWORD_HASH=
