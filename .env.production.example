# Copy to .env.production on the VPS and fill in (never commit .env.production).
# docs/deploy-vps.md explains each step.

# Your domain (an A record pointing to this VPS). Caddy gets the https certificate by itself.
DOMAIN=seudominio.com.br
APP_URL=https://seudominio.com.br
FRONTEND_URL=https://seudominio.com.br
FRONTEND_URLS=https://seudominio.com.br

APP_NAME=linkcut
APP_ENV=production
APP_DEBUG=false
# Filled in automatically on the first start (keep it: changing it logs everyone out).
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=warning

# Database (MySQL runs in Docker). Use long random passwords: openssl rand -base64 24
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=linkcut
DB_USERNAME=linkcut
DB_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-tambem

SESSION_DRIVER=database
QUEUE_CONNECTION=database
# Cache and rate limits in Redis (the redis service of docker-compose.prod.yml, which also sets these two).
CACHE_STORE=redis
REDIS_HOST=redis
FILESYSTEM_DISK=local

# Real e-mail (2FA codes, booking e-mails). Example: Brevo (free, 300/day) → SMTP & API → SMTP keys.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=seu-login-smtp
MAIL_PASSWORD=sua-chave-smtp
MAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
MAIL_FROM_NAME="linkcut"

# SMS off until there is a budget for a provider (the code goes by e-mail).
SMS_ENABLED=false
SMS_DRIVER=log

# Push notifications: the keys are filled in automatically on the first start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br

# Address lookup on the map (OpenStreetMap). Put your e-mail in the user agent, as their policy asks.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="linkcut/1.0 (voce@seudominio.com.br)"

# Optional: error tracking (sentry.io). Leave empty to turn off.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=false
VITE_SENTRY_DSN=

# Privacy policy (/privacidade, LGPD): who is responsible for the data and the contact for privacy requests.
VITE_PRIVACY_CONTROLLER="Nome ou razão social"
VITE_PRIVACY_DOCUMENT="CNPJ ou CPF"
VITE_PRIVACY_EMAIL=privacidade@seudominio.com.br

PULSE_ENABLED=false

# Backups (make prod-backup): passphrase of the encrypted file. Keep a copy in your password manager.
# Generate with: openssl rand -base64 32
BACKUP_PASSPHRASE=
# Optional: copy each backup off the VPS with rclone (e.g. r2:linkcut-backups). Empty = only on the VPS.
BACKUP_RCLONE_REMOTE=

# Optional: check-in URL of the uptime monitor (healthchecks.io). Pinged every 5 min by the scheduler and the queue.
HEARTBEAT_URL=

# Client sign-in with Google (off until you fill these). Web client in Google Cloud, free (not used by the barber login).
# Authorized redirect: https://SEU-DOMINIO/api/client/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true shows the "Continuar com Google" button (only after the two keys above are filled).
VITE_GOOGLE_LOGIN=false

